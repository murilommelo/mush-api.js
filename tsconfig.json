{
  "compilerOptions": {
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "newLine": "crlf",
    "rootDir": "src",
    "outDir": "dist",
    "target": "esnext",
    "paths": {
      "@stats-types/*": [
        "./src/typings/player/stats/*"
      ],
      "@api-types/*": [
        "./src/typings/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts"
  ]
}