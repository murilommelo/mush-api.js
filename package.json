{
  "name": "mush-api.js",
  "description": "Unofficial Mush API wrapper for Node.js",
  "version": "3.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "keywords": [
    "mush",
    "api",
    "wrapper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murilommelo/mush-api.js.git"
  },
  "bugs": {
    "url": "https://github.com/murilommelo/mush-api.js/issues"
  },
  "homepage": "https://github.com/murilommelo/mush-api.js#readme",
  "author": "murilommelo (https://github.com/murilommelo/)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run --typecheck",
    "build": "tsc --noEmit && tsdown",
    "lint": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unplugin-replace": "^0.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">= 18"
  },
  "engineStrict": true
}
